# O3 backend with the auditlogweb module and Envers enabled.
# Temurin 8 matches the JDK the release and CI builds compile with (the parent
# pom uses source/target 1.8 without --release, so a newer JDK could link
# against APIs missing at runtime on Java 8 hosts).
# $BUILDPLATFORM: the omod is architecture-independent, so build it once on
# the build host instead of re-compiling under QEMU for each target platform.
FROM --platform=$BUILDPLATFORM maven:3.9-eclipse-temurin-8 AS builder

COPY . /build
WORKDIR /build
RUN --mount=type=cache,target=/root/.m2 mvn clean package -DskipTests -B

FROM openmrs/openmrs-reference-application-3-backend:nightly

COPY --from=builder /build/omod/target/auditlogweb-*.omod /openmrs/distribution/openmrs_modules/

# The configuration the module's admin hint prescribes (messages.properties):
# Envers on, and hbm2ddl.auto=update permanently so the Envers schema is
# created before core's first audited write and re-checked against the audited
# mappings on each boot (SchemaUpdate only ever adds). Note SchemaUpdate logs
# DDL failures and continues, so missing _AUD tables surface in the backend
# log, not as a startup failure. Both overridable at runtime; once the audit
# schema exists, extra backend replicas can set HBM2DDL to none to avoid
# concurrent DDL races, but never set it on a fresh database.
ENV OMRS_EXTRA_HIBERNATE_INTEGRATION_ENVERS_ENABLED="true"
ENV OMRS_EXTRA_HIBERNATE_HBM2DDL_AUTO="update"
