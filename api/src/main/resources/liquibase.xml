<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9
                  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">

    <changeSet id="auditlogweb-2026-04-create-audit-security-event" author="sudhanshu-raj">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="audit_security_event"/>
            </not>
        </preConditions>
        <comment>Create audit_security_event table for security event logging</comment>
        <createTable tableName="audit_security_event">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(38)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(50)"/>
            <column name="user_uuid" type="VARCHAR(38)"/>
            <column name="event_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="ip_address" type="VARCHAR(100)"/>
            <column name="user_agent" type="VARCHAR(1000)"/>
            <column name="session_id" type="VARCHAR(256)"/>
            <column name="details" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="auditlogweb-20260622-create-read-audit-log-table" author="sudhanshu_raj">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="read_audit_log"/>
            </not>
        </preConditions>
        <createTable tableName="read_audit_log">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="read_success" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="user_uuid" type="varchar(38)">
                <constraints nullable="false"/>
            </column>
            <column name="event_time" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="ip_address" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="user_agent" type="varchar(500)">
                <constraints nullable="true"/>
            </column>
            <column name="session_id" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="uuid" type="char(38)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="auditlogweb-20260622-create-read-audit-entity-metadata-table" author="sudhanshu_raj">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="read_audit_entity_metadata"/>
            </not>
        </preConditions>
        <createTable tableName="read_audit_entity_metadata">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="read_audit_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="entity_uuid" type="varchar(38)">
                <constraints nullable="false"/>
            </column>
            <column name="patient_uuid" type="varchar(38)"/>
            <column name="patient_name" type="varchar(255)"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_read_audit_entity_metadata_read_audit"
                                 baseTableName="read_audit_entity_metadata"
                                 baseColumnNames="read_audit_id"
                                 referencedTableName="read_audit_log"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

       <changeSet id="auditlogweb-20260704-create-read-audit-event-time-idx" author="sudhanshu_raj">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="read_audit_log_event_time_idx"/>
            </not>
        </preConditions>
        <createIndex tableName="read_audit_log" indexName="read_audit_log_event_time_idx">
            <column name="event_time"/>
        </createIndex>
    </changeSet>

    <changeSet id="auditlogweb-20260704-create-read-audit-session-id-idx" author="sudhanshu_raj">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="read_audit_log_session_id_idx"/>
            </not>
        </preConditions>
        <createIndex tableName="read_audit_log" indexName="read_audit_log_session_id_idx">
            <column name="session_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="auditlogweb-20260704-create-read-audit-entity-name-idx" author="sudhanshu_raj">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="read_audit_log_entity_name_idx"/>
            </not>
        </preConditions>
        <createIndex tableName="read_audit_log" indexName="read_audit_log_entity_name_idx">
            <column name="entity_name"/>
        </createIndex>
    </changeSet>
    <changeSet id="auditlogweb-20260722-create-module_event_audit-table" author="sudhanshu-raj">
        <preConditions>
            <not>
                <tableExists tableName="module_event_audit"/>
            </not>
        </preConditions>
        <comment>Create module_event_audit  table for auditing the module event actions</comment>
        <createTable tableName="module_event_audit">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="module_id" type="VARCHAR(50)" />
            <column name="module_name" type="VARCHAR(50)" />
            <column name="module_version" type="VARCHAR(50)" />
            <column name="event_success" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name = "failure_reason" type="VARCHAR(500)" />
            <column name="username" type="VARCHAR(50)" />
            <column name="user_uuid" type="VARCHAR(38)" />
            <column name="event_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="ip_address" type="VARCHAR(100)"/>
            <column name="user_agent" type="VARCHAR(500)"/>
            <column name="session_id" type="VARCHAR(256)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>